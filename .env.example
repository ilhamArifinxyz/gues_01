# =====================================================================
# SISTEM MANAJEMEN ABSENSI BERBASIS WEB (KELOMPOK 10 RPL UNIV TADULAKO)
# Berkas Konfigurasi Lingkungan (Environment Variables Example)
# Salin berkas ini menjadi '.env' sebelum menjalankan Docker Compose:
# cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# KONFIGURASI BASIS DATA POSTGRESQL
# ---------------------------------------------------------------------
# Kredensial akun PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=absensi_db
POSTGRES_PORT=5432

# URL koneksi basis data yang dikonsumsi oleh backend Go Chi
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@postgres:5432/absensi_db?sslmode=disable

# ---------------------------------------------------------------------
# KONFIGURASI BACKEND API (GOLANG CHI)
# ---------------------------------------------------------------------
# Port HTTP server backend
PORT=8080

# Kunci rahasia untuk penandatanganan dan verifikasi token JWT HMAC-SHA256
# PERINGATAN: Selalu ubah nilai ini di lingkungan produksi menjadi string acak berkekuatan tinggi!
JWT_SECRET=absensi-secret-key-k10-rpl-2026-very-secure

# Path direktori penyimpanan berkas unggahan bukti presensi dan dokumen izin
UPLOAD_DIR=/app/uploads

# Base URL publik backend
BACKEND_BASE_URL=http://localhost:8080

# Zona waktu sistem kontainer (WITA - Waktu Indonesia Tengah untuk Palu)
TZ=Asia/Makassar

# ---------------------------------------------------------------------
# KONFIGURASI FRONTEND (REACT VITE & NGINX)
# ---------------------------------------------------------------------
# Base URL API yang diakses oleh frontend.
# Dalam arsitektur Nginx reverse proxy, gunakan '/api/v1' agar seluruh panggilan
# API dirouting oleh reverse proxy Nginx tanpa terpengaruh isu CORS peramban.
VITE_API_BASE_URL=/api/v1

# Port ekspose frontend
FRONTEND_PORT_HTTP=80
FRONTEND_PORT_ALT=3000
